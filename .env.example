# 视觉 / 文本大模型：OpenAI 兼容的 /chat/completions 接口
# 阿里云百炼（兼容模式）
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
# 其他可选：
#   智谱        VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4      VISION_MODEL=glm-4v-plus
#   硅基流动    VISION_API_BASE=https://api.siliconflow.cn/v1            VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
#   OpenAI      VISION_API_BASE=https://api.openai.com/v1                VISION_MODEL=gpt-4o

VISION_API_KEY=

# 文案生成可单独指定模型，留空则复用 VISION_MODEL
TEXT_MODEL=

# 出图用的视觉生成模型（阿里云通义万相，异步任务制）
IMAGE_MODEL=wanx2.1-t2i-turbo
# 竖版 3:4 左右最适合小红书；不支持时会自动退回 1024*1024
IMAGE_SIZE=720*1280

# 视频模型（通义万相视频生成，异步任务制，20 秒 ~ 2 分钟）
# 只需填 t2v / i2v 任一档，实际调用由「图生 / 文生 + 画质档位」自动推导
VIDEO_MODEL=wanx2.1-t2v-turbo

# 说明：VISION_API_KEY 为空时，接口返回模拟数据，方便先把界面跑通。
